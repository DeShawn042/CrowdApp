{
  "expo": {
    "name": "Prescout",
    "slug": "prescout",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "prescout",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.prescout.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Prescout uses your location to find nearby venues and calculate distances.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Prescout monitors your location in the background to notify you when you arrive at a saved venue so you can report the crowd level.",
        "UIBackgroundModes": ["location", "fetch", "remote-notification"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F0F13",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.prescout.app",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Prescout needs access to your photos to attach them to reviews.",
          "cameraPermission": "Prescout needs access to your camera to take photos for reviews."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F0F13",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#7C6FFF",
          "androidMode": "default",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Prescout uses your location in the background to notify you when you arrive at a saved venue.",
          "locationWhenInUsePermission": "Prescout uses your location to find nearby venues and show distances."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
